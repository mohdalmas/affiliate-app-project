# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Stage 10+: the SERVICE ROLE key (secret — same API settings page, further
# down). This bypasses Row Level Security, so it has NO NEXT_PUBLIC_ prefix
# and must never be exposed to the browser — it's only read by server-side
# code (see lib/supabase/service.ts). Needed for the public product pages
# and the /go/[slug] redirect to read/write data without a logged-in user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
